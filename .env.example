
# Clave secreta para la gestión de sesiones y protección CSRF
SECRET_KEY=SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_SECRETA_ALEATORIA

# Base de datos local lista para usar. Para MySQL, cambia DB_DRIVER a mysql.
DB_DRIVER=sqlite
DB_SQLITE_PATH=instance/inmotech.sqlite3
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inmotech_db

# Servidor de desarrollo
HOST=127.0.0.1
PORT=5000
FLASK_ENV=development
FLASK_DEBUG=1
